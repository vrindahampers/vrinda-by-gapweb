{
  // ---------------------------------------------------------------------------
  // vrindahampers Realtime Database security rules.
  //
  // This file intentionally uses `//` comments. `firebase deploy --only database`
  // reads it verbatim (`options.config.readProjectFile`) and validates the syntax
  // SERVER-SIDE, so it is not parsed as strict JSON here — comments are supported
  // by both the Firebase CLI and the Console rules editor.
  // Strict JSON parsers (VS Code's JSON validator, generic linters) will flag the
  // comments; that is expected and safe. Do not strip them.
  //
  // Deploy:  firebase deploy --only database
  //
  // ROLE RESOLUTION (read this before changing any expression below):
  //   Every operations check is an OR of two sources of truth:
  //     1. the legacy registry nodes  /admins/$uid, /staff/$uid, /deliveryManagers/$uid
  //     2. the profile field          /users/$uid/role  ("superadmin" | "staff" | "delivery")
  //   Source 2 is the one the app reads (VrindaAuth.getUserRole / requireAdminRole) and the
  //   one the Super Admin Portal displays. Before this was OR-ed in, a user whose profile said
  //   "superadmin" but who had no /admins/$uid row passed the UI gate yet every write was
  //   denied by the database (products, coupons, settings, seo, banners, blogs, role changes).
  //   Bootstrapping the very first super admin still has to happen once in the Firebase console
  //   (set /users/<uid>/role = "superadmin"), because no client may write its own role.
  //   After that, VrindaAdmin.updateUserRole keeps users/$uid/role and the registry nodes in sync.
  // ---------------------------------------------------------------------------
  "rules": {
    "users": {
      // Parent-level read: listing the whole /users node (the RBAC team table)
      // evaluates THIS rule, not the $uid children below — child rules can
      // never grant a read of their parent. Operations roles only.
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('deliveryManagers').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'delivery' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')",
      "$uid": {
        // Users can read and write only their own record; Super Admins & Staff can view user records
        ".read": "auth != null && (auth.uid === $uid || (root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner'))",
        ".write": "auth != null && (auth.uid === $uid || (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner'))",
        "role": {
          // ROLE ESCALATION GUARD.
          // Writing a role is powerful, so it is split from the rest of the user
          // record and checked far more strictly than "is an admin":
          //   1. Nobody may write their OWN role - not even a manager or owner.
          //      Without this, a manager could simply promote themselves to owner.
          //   2. Only an OWNER may grant or revoke owner/manager. A manager or
          //      super admin can still promote staff and delivery managers (the
          //      existing workflow), but can never mint a peer.
          // `newData.val()` is the role being written, so a write that would set
          // a new role to 'owner' or 'manager' needs an owner to be performing it.
          ".write": "auth != null && auth.uid !== $uid && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner') && ((newData.val() === 'owner' || newData.val() === 'manager') ? root.child('users').child(auth.uid).child('role').val() === 'owner' : true)"
        }
      }
    },
    "admins": {
      // Super Admin registry - only Super Admins can read or write
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')"
    },
    "staff": {
      // Staff registry - only Super Admins can assign staff
      ".read": "auth != null && ((root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner'))",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')"
    },
    "deliveryManagers": {
      // Delivery managers registry - Super Admins manage
      ".read": "auth != null && ((root.child('admins').child(auth.uid).exists() || root.child('deliveryManagers').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'delivery' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner'))",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')"
    },
    "cart": {
      "$uid": {
        // Only the owner can read/write their cart
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "wishlist": {
      "$uid": {
        // Only the owner can read/write their wishlist
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "orders": {
      // Operations roles (Super Admin / Staff / Delivery Manager / Super Admin+ / ++) read and
      // update every order. Customers only ever touch their own order via the $orderId rules below.
      // IMPORTANT: Realtime Database rules cascade DOWNWARDS only - a permissive parent can never
      // be tightened by a child, so the parent must stay locked to operations roles.
      //
      // There is deliberately NO parent ".write" here. A parent .write would cascade down and
      // grant EVERY operations role the right to delete any order, because rules can only ever
      // loosen, never tighten. Writes (and the stricter delete rule) live on $orderId instead,
      // where the delete case can be checked explicitly.
      ".read": "auth != null && ((root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('deliveryManagers').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'delivery' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner'))",
      "$orderId": {
        // Owner reads their own order; operations roles read all.
        ".read": "auth != null && (data.child('userId').val() === auth.uid || (root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('deliveryManagers').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'delivery' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner'))",
        // CREATE + UPDATE: any operations role, or a customer creating their own order.
        // DELETING an order (newData no longer exists) is a separate, stricter case below and
        // is reserved for Super Admin+ and Super Admin++ - a Super Admin cannot delete an order
        // outright, they can only cancel it through the status flow.
        ".write": "auth != null && ((!newData.exists() && (root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')) || ((root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('deliveryManagers').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'delivery' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner') && newData.exists()) || (!data.exists() && newData.exists() && newData.child('userId').val() === auth.uid))",
        // Narrow owner escape hatch for the Phase 5 cancellation-request markers.
        "cancellationStatus": {
          ".write": "auth != null && ((root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner') || (!data.exists() && root.child('userOrders').child(auth.uid).child($orderId).exists()))"
        },
        "cancellationRequestId": {
          ".write": "auth != null && ((root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner') || (!data.exists() && root.child('userOrders').child(auth.uid).child($orderId).exists()))"
        }
      }
    },
    "cancellationRequests": {
      // Customers submit cancellation requests for their own paid orders;
      // Super Admins & Staff review, approve or reject them.
      // Parent-level read: the admin queue reads the WHOLE node, and a $requestId
      // child rule can never grant a read of its parent (same trap as /users).
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')",
      "$requestId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || (root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner'))",
        ".write": "auth != null && ((root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner') || (!data.exists() && root.child('userOrders').child(auth.uid).child(newData.child('orderId').val()).exists()))"
      }
    },
    "userOrders": {
      // Lightweight per-customer order index (Phase 4/5) - one cheap read per customer.
      "$uid": {
        // Delivery managers also maintain the index because status/dispatch updates write here.
        ".read": "auth != null && (auth.uid === $uid || (root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('deliveryManagers').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'delivery' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner'))",
        ".write": "auth != null && (auth.uid === $uid || (root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('deliveryManagers').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'delivery' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner'))"
      }
    },
    "adminNotifications": {
      // Staff-facing alerts for new orders and cancellation requests; customers never read these.
      ".read": "auth != null && ((root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('deliveryManagers').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'delivery' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner'))",
      ".write": "auth != null"
    },
    "paymentSessions": {
      // FamGateway order -> orderId ledger so payment-return.html can recover the created order.
      "$gatewayOrderId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "checkoutDrafts": {
      // Cross-device recovery of an in-progress checkout form (localStorage is the primary copy).
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "products": {
      // Products are publicly readable by anyone; editable only by Admins
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')"
    },
    "categories": {
      // Categories are publicly readable; editable only by Admins
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')"
    },
    "reviews": {
      // Publicly readable; verified customers own their own review rows; Staff/Admins moderate all.
      ".read": true,
      "$productId": {
        // Moderation (delete any review) is reserved for Staff and Super Admins.
        ".write": "auth != null && ((root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner'))",
        "$reviewId": {
          // A verified shopper may only create/edit/remove a review stamped with their own uid.
          ".write": "auth != null && auth.token.email_verified == true && (!data.exists() || data.child('userId').val() === auth.uid) && (!newData.exists() || newData.child('userId').val() === auth.uid)"
        }
      }
    },
    "coupons": {
      // Coupons are publicly readable for checkout validation; only Admins write
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')"
    },
    "banners": {
      // Promotional banners managed by Super Admin
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')"
    },
    "blogs": {
      // Blog posts managed by Super Admin
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')"
    },
    "settings": {
      // Site config, payment details, contact info managed by Super Admin
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')"
    },
    "seo": {
      // SEO meta configurations managed by Super Admin
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')"
    },
    "faqs": {
      // Homepage FAQ answers, edited from Admin -> FAQ & Content.
      // Public read (the homepage is public), admin-only write.
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')"
    },
    "siteContent": {
      // Every editable string, image URL, button label and link target on the
      // storefront, keyed by a dotted path (e.g. "home.hero.title"). Publicly
      // readable so pages can render it, and writable ONLY by Super Admin++
      // ("owner"). A manager or super admin is deliberately excluded: this node
      // is the whole-site editor and is the owner's alone.
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
    },
    "newsletter": {
      // Newsletter subscribers. The signup form is on the PUBLIC homepage, so
      // anyone must be able to add a row — but only ever their own, and only
      // the handful of fields the form actually collects.
      //
      // A visitor may CREATE a subscription and may UPDATE or DELETE their own
      // row, keyed by uid. The `anon` uid is what a signed-out visitor gets, so
      // two different anonymous people can both subscribe.
      //
      // Deliberately NOT public-read: the whole point of this table is the email
      // addresses, and only ops roles need to read it (to export a campaign).
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        // Unsubscribe is allowed without proving who you are beyond owning the
        // row; changing the stored email address is NOT (that would let anyone
        // hijack a row and redirect someone else's mail).
        ".write": "auth != null && auth.uid === $uid && !newData.child('email').isNumber()",
        // A new subscription may only set the allowed fields, and the caller may
        // not stamp a status other than "subscribed" (no self-granting "unsubscribed"
        // is pointless, but this also blocks arbitrary junk columns).
        ".validate": "newData.hasChildren(['email', 'createdAt']) && newData.child('email').isString() && newData.child('email').val().length <= 254 && (!newData.child('source').exists() || newData.child('source').isString())"
      }
    },
    "customRequests": {
      // Customers submit bespoke configurator designs; Staff/Admins review them
      // Parent-level read so the admin portal can list EVERY customer's designs -
      // a $uid child rule can never grant a read of the whole node.
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('admins').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'owner'))",
        ".write": "auth != null && auth.uid === $uid && auth.token.email_verified == true"
      }
    }
  }
}
